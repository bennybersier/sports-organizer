# ---------------------------------------------------------------------------
# Sport Club Organizer — environment configuration
#
# Copy to .env.local and fill in. Every value below is validated at startup by
# src/env.ts; the app refuses to boot rather than running half-configured.
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses Row Level Security. Server-side only — never expose to the browser,
# never commit, and rotate immediately if it leaks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Encryption ------------------------------------------------------------
# 32 bytes, base64. Encrypts tenant AI provider keys and OAuth refresh tokens
# at rest. Losing this makes existing stored secrets unrecoverable.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# --- Application -----------------------------------------------------------
# Used to build OAuth redirect URLs and invitation links. Must match the origin
# the app is actually served from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Phase 7) -------------------------------------------------------
# EMAIL_FROM=club@yourdomain.example
# RESEND_API_KEY=

# --- Google Calendar (Phase 8) ---------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

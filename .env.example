# ---------------------------------------------------------------------------
# Sport Club Organizer — environment configuration
#
# Copy to .env.local and fill in. Every value below is validated at startup by
# src/env.ts; the app refuses to boot rather than running half-configured.
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development

# --- Supabase --------------------------------------------------------------
# Project Settings -> API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key. Safe in the browser: it is subject to RLS exactly like an
# unauthenticated request.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key. Bypasses Row Level Security. Server-side only — never expose to
# the browser, never commit, and rotate immediately if it leaks.
SUPABASE_SECRET_KEY=sb_secret_...

# Note: the legacy `anon` / `service_role` JWT keys still work in these slots,
# but Supabase deprecates them at the end of 2026 and the app logs a warning.

# --- Local tooling only (never needed at runtime) ---------------------------
# These two are read by the Supabase CLI, not by the app. Both are optional and
# only used to apply migrations from this machine.
#
# Personal access token — https://supabase.com/dashboard/account/tokens
# Lets the CLI act as your account without an interactive `supabase login`.
# SUPABASE_ACCESS_TOKEN=sbp_...
#
# Database password — Project Settings -> Database -> Connection string.
# Lets `supabase db push` connect directly, regardless of account privileges.
# SUPABASE_DB_PASSWORD=

# --- Encryption ------------------------------------------------------------
# 32 bytes, base64. Encrypts tenant AI provider keys and OAuth refresh tokens
# at rest. Losing this makes existing stored secrets unrecoverable.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# --- Application -----------------------------------------------------------
# Used to build OAuth redirect URLs and invitation links. Must match the origin
# the app is actually served from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Phase 7) -------------------------------------------------------
# EMAIL_FROM=club@yourdomain.example
# RESEND_API_KEY=

# --- Google Calendar (Phase 8) ---------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
